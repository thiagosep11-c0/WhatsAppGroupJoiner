<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e posterior: o token do painel online (uma credencial) não vai para o backup nem para outro celular -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="panel_prefs.xml" />
        <exclude domain="file" path="fotos" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="panel_prefs.xml" />
        <exclude domain="file" path="fotos" />
    </device-transfer>
</data-extraction-rules>
